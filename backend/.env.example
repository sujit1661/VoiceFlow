# Flow — Environment Variables
# Built by Sujit Sadalage
# Copy this file to .env and fill in your values

# Required: Get your free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Environment: "development" or "production"
ENVIRONMENT=development

# Allowed CORS origins (comma-separated). In production set this to your domain.
# Example: ALLOWED_ORIGINS=https://flow.yourdomain.com,https://www.yourdomain.com
# Leave empty in development — defaults to localhost
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000

# Optional: Protect the /api/* endpoints with an API key.
# Set this to any long random string. Leave blank to allow unauthenticated access (dev default).
# Clients must send the header:  X-API-Key: <value>
FLOW_API_KEY=

# Rate limiting: max requests per IP per window (applies to /api/transcribe and /api/polish)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# ── Hotkey service settings (used by hotkey_service/service.py) ───────────────
# Backend URL that the hotkey service calls
FLOW_API=http://localhost:8000

# Dictation context: general | email | document | note | chat | code
FLOW_CONTEXT=general

# Set to "false" to type the raw transcript without AI polishing
FLOW_AUTO_POLISH=true
